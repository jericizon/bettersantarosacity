{
  "name": "bettersantarosacity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --port 4027",
    "build": "nuxt build",
    "prebuild": "node scripts/sync-public-data.mjs && node scripts/generate-sitemap.mjs",
    "generate": "nuxt generate",
    "pregenerate": "node scripts/sync-public-data.mjs && node scripts/generate-sitemap.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "index:search": "pagefind --site dist",
    "build:prod": "node scripts/sync-public-data.mjs && node scripts/generate-sitemap.mjs && nuxt generate && pagefind --site dist",
    "serve": "serve dist -l 4026"
  },
  "dependencies": {
    "lucide-vue-next": "^0.475.0",
    "maplibre-gl": "5.24.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "d3-delaunay": "6.0.4",
    "happy-dom": "^15.11.7",
    "pagefind": "^1.3.0",
    "polygon-clipping": "0.15.7",
    "postcss": "^8.4.49",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.8"
  }
}
